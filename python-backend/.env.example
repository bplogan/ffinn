# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=ffinn
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS_RAW=http://localhost:3000,https://localhost:3000
ENVIRONMENT=development
DEBUG=true

# ─── Database ──────────────────────────────────────────────────────────────────
# Matches the `db` service in docker-compose.yml: start it with `docker compose up -d db`
DATABASE_URL=postgresql+asyncpg://postgres:localpass@localhost:5433/ffinn
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-THIS-TO-YOUR-SECRET-KEY-AT-LEAST-32-CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Encryption ────────────────────────────────────────────────────────────────
# Used to encrypt AI provider API keys, source control tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE-THIS-TO-A-FERNET-KEY-GENERATE-WITH-PYTHON

# ─── Identity ──────────────────────────────────────────────────────────────────
REQUIRE_EMAIL_CONFIRMATION=false
ALLOW_REGISTRATION=true
DEFAULT_ADMIN_EMAIL=admin@localhost
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# Staging demo tenant (QA accounts + sample data for host admin testing)
# Enabled automatically when ENVIRONMENT=staging, or set SEED_STAGING_DEMO=true locally.
SEED_STAGING_DEMO=false
STAGING_DEMO_TENANT_NAME=staging
STAGING_DEMO_PASSWORD=StagingDemo123!

# ─── Multi-tenancy ─────────────────────────────────────────────────────────────
MULTI_TENANCY_ENABLED=true

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@ffinn.dev
SMTP_FROM_NAME=ffinn

# ─── OAuth / SSO ───────────────────────────────────────────────────────────────
# Per-tenant SSO (OIDC and SAML 2.0) is configured in the portal under Administration > SSO.
# The values below are optional defaults.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_ENABLED=true
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=

# ─── PayPal ────────────────────────────────────────────────────────────────────
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ─── Subscription Settings ─────────────────────────────────────────────────────
SUBSCRIPTION_EXPIRATION_WARNING_DAYS=7
SUBSCRIPTION_NOTIFICATION_DAYS=7,3,1
SUBSCRIPTION_AUTO_DEACTIVATE_EXPIRED=true
SUBSCRIPTION_ENABLE_EMAIL_NOTIFICATIONS=true

# ─── File Storage ──────────────────────────────────────────────────────────────
FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# AZURE BLOB (production)
# FILE_STORAGE_BACKEND=azure
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=logos

# AWS S3
# FILE_STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# AWS_REGION=us-east-1

# ─── AI Agent ──────────────────────────────────────────────────────────────────
AI_AGENT_RATE_LIMIT_PER_MINUTE=10
AI_AGENT_MAX_CONCURRENT=3
AI_AGENT_MAX_PROMPT_LENGTH=10000
AI_AGENT_MAX_RETRIES=3
AI_AGENT_TIMEOUT_MINUTES=15
CALLBACK_TOKEN=CHANGE-THIS-TO-A-RANDOM-SECRET
# Must match GitHub repo secret FFINN_CALLBACK_TOKEN (set automatically via Setup Repository)
AI_AGENT_TIMEOUT_SECONDS=900

# ─── Source Control Defaults ───────────────────────────────────────────────────
DEFAULT_SOURCE_CONTROL_PROVIDER=github
DEFAULT_BRANCH_PREFIX=ai-feature/

# ─── Redis (optional — distributed rate limiting / queue) ───────────────────────
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# ─── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
